# FalkorDB Cloud connection
FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=your-password

# LLM provider (Anthropic)
LLM_API_KEY=your-api-key
LLM_MODEL=claude-sonnet-5-5
# Only needed if your API key isn't scoped to a workspace (Console > Settings > Workspaces)
LLM_WORKSPACE_ID=

# Optional: how many questions can run at once (default 4; use 2 on Render's free tier)
MAX_CONCURRENT_ASKS=4
